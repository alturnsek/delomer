[Unit]
Description=Delomer deploy webhook receiver
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/home/aleksandert/delomer
EnvironmentFile=/home/aleksandert/delomer/.env
ExecStart=/usr/bin/node /home/aleksandert/delomer/deploy/webhook-server.js
Restart=on-failure
RestartSec=5
User=aleksandert

[Install]
WantedBy=multi-user.target
