PORT=3000

# Osnovni URL aplikacije, uporabljen za povezave v vabilih (set-password link).
# Lokalno: http://localhost:3000, na TrueNAS: https://app.delomer.top
APP_BASE_URL=http://localhost:3000

DB_HOST=db
DB_PORT=3306
DB_USER=delomer_user
DB_PASSWORD=change_me
DB_NAME=delomer
DB_ROOT_PASSWORD=change_me_root

SESSION_SECRET=change_me_session_secret

JWT_SECRET=change_me_jwt_secret

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Resend (pošiljanje vabil po emailu) ---
# Uporabi se samo, če SUPER_ADMIN v UI preklopi "način pošiljanja emailov"
# na "real" (privzeto "log" - povezava se samo izpiše v strežniške loge).
RESEND_API_KEY=
# Mora biti naslov na verificirani domeni pri Resend (npr. info@delomer.top)
INVITE_EMAIL_FROM=Delomer <info@delomer.top>

# --- CI/CD (Docker Hub + webhook deploy) ---
# DOCKERHUB_USERNAME mora biti enak na VM (.env) in v GitHub secrets,
# da "docker compose pull" povleče isto sliko, ki jo je zgradil GitHub Actions.
DOCKERHUB_USERNAME=

# Samo na VM: vrata, na katerih posluša deploy/webhook-server.js
WEBHOOK_PORT=9000

# Samo na VM: mora biti IDENTIČEN kot GitHub secret DEPLOY_WEBHOOK_SECRET
DEPLOY_WEBHOOK_SECRET=change_me_webhook_secret

# --- Samo na TrueNAS (reverse proxy preko Nginx Proxy Manager) ---
# Ime Docker omrežja, na katerem posluša NPM (najdeš ga z `docker network ls`
# in `docker inspect <npm_container> --format '{{json .NetworkSettings.Networks}}'`).
# App kontejner se priklopi nanj, da je dosegljiv za NPM brez javno izpostavljenih vrat.
NPM_NETWORK_NAME=npm_proxy
